{
  "name": "gym-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration local",
    "start:cloud": "ng serve",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "three": "^0.170.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "description": "An Ionic project"
}
